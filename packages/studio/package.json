{
  "name": "@noverax/courier-studio",
  "version": "0.0.0",
  "description": "Standalone Studio server and UI for @noverax/courier",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "devtools",
    "studio",
    "debugging",
    "inspector"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/studio"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "courier-studio": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./vite": {
      "types": "./lib/vite.d.ts",
      "import": "./lib/vite.js",
      "default": "./lib/vite.js"
    },
    "./next": {
      "types": "./lib/next.d.ts",
      "import": "./lib/next.js",
      "default": "./lib/next.js"
    },
    "./nuxt": {
      "types": "./lib/nuxt.d.ts",
      "import": "./lib/nuxt.js",
      "default": "./lib/nuxt.js"
    },
    "./webpack": {
      "types": "./lib/webpack.d.ts",
      "import": "./lib/webpack.js",
      "default": "./lib/webpack.js"
    },
    "./esbuild": {
      "types": "./lib/esbuild.d.ts",
      "import": "./lib/esbuild.js",
      "default": "./lib/esbuild.js"
    },
    "./rollup": {
      "types": "./lib/rollup.d.ts",
      "import": "./lib/rollup.js",
      "default": "./lib/rollup.js"
    },
    "./astro": {
      "types": "./lib/astro.d.ts",
      "import": "./lib/astro.js",
      "default": "./lib/astro.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js",
      "default": "./lib/react.js"
    },
    "./vue": {
      "types": "./lib/vue.d.ts",
      "import": "./lib/vue.js",
      "default": "./lib/vue.js"
    },
    "./sveltekit": {
      "types": "./lib/sveltekit.d.ts",
      "import": "./lib/sveltekit.js",
      "default": "./lib/sveltekit.js"
    },
    "./remix": {
      "types": "./lib/remix.d.ts",
      "import": "./lib/remix.js",
      "default": "./lib/remix.js"
    },
    "./solid": {
      "types": "./lib/solid.d.ts",
      "import": "./lib/solid.js",
      "default": "./lib/solid.js"
    },
    "./angular": {
      "types": "./lib/angular.d.ts",
      "import": "./lib/angular.js",
      "default": "./lib/angular.js"
    }
  },
  "files": [
    "lib",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier-studio-core": "*",
    "citty": "^0.2.2",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "open": "^11.0.4",
    "oxc-parser": "0.145.0",
    "socket.io": "^4.8.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@noverax/courier": "*",
    "next": ">=14.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/compression": "^1.8.1",
    "esbuild": "^0.28.2",
    "rollup": "^4.63.4"
  }
}
