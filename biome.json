{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "*.{ts,cjs,mjs,json}",
      "types/**",
      "scripts/**",
      "packages/*/src/**",
      "packages/*/tests/**",
      "packages/*/*.{ts,json}",
      "packages/studio/ui/src/**",
      "packages/studio/ui/__tests__/**",
      "packages/studio/ui/*.{ts,json}",
      "examples/*/src/**",
      "examples/*/*.{ts,json}",
      "!**/package.json",
      "!**/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "off",
        "noDefaultExport": "error",
        "noEnum": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/*/tests/**",
        "packages/studio/ui/__tests__/**",
        "scripts/**/*.test.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "useYield": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.{ts,cjs,mjs}", "**/courier.mocks.ts", "**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/studio/ui/src/routes/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": {
              "level": "error",
              "options": { "allowedEnvVars": ["GITHUB_ACTIONS"] }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/studio/ui/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["Checkbox", "Switch", "TickBox"]
              }
            }
          }
        }
      }
    }
  ]
}
