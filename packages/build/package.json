{
  "name": "@noverax/courier-build",
  "version": "0.5.0",
  "description": "Courier at build time: loads courier.config the way every Courier tool does, and hands a page's bundle the routes its proxy client may call through a plugin for the app's bundler, with no routes file to generate",
  "keywords": [
    "courier",
    "vite",
    "vite-plugin",
    "rsbuild",
    "rspack",
    "webpack",
    "esbuild",
    "rollup",
    "rolldown",
    "jest",
    "metro",
    "expo",
    "react-native",
    "bundler",
    "plugin",
    "proxy",
    "routes",
    "typescript",
    "type-safe",
    "api"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/build"
  },
  "homepage": "https://courier.noverax.cloud/docs/proxy-mode/expose",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js",
      "default": "./lib/config/index.js"
    },
    "./vite": {
      "types": "./lib/vite/index.d.ts",
      "import": "./lib/vite/index.js",
      "default": "./lib/vite/index.js"
    },
    "./webpack": {
      "types": "./lib/webpack/index.d.ts",
      "import": "./lib/webpack/index.js",
      "default": "./lib/webpack/index.js"
    },
    "./rspack": {
      "types": "./lib/rspack/index.d.ts",
      "import": "./lib/rspack/index.js",
      "default": "./lib/rspack/index.js"
    },
    "./rsbuild": {
      "types": "./lib/rsbuild/index.d.ts",
      "import": "./lib/rsbuild/index.js",
      "default": "./lib/rsbuild/index.js"
    },
    "./esbuild": {
      "types": "./lib/esbuild/index.d.ts",
      "import": "./lib/esbuild/index.js",
      "default": "./lib/esbuild/index.js"
    },
    "./rollup": {
      "types": "./lib/rollup/index.d.ts",
      "import": "./lib/rollup/index.js",
      "default": "./lib/rollup/index.js"
    },
    "./jest": {
      "types": "./lib/jest/transformer.d.cts",
      "default": "./lib/jest/transformer.cjs"
    },
    "./metro": {
      "import": {
        "types": "./lib/metro/index.d.ts",
        "default": "./lib/metro/index.js"
      },
      "require": {
        "types": "./lib/metro/index.d.cts",
        "default": "./lib/metro/index.cjs"
      },
      "default": "./lib/metro/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "config": [
        "./lib/config/index.d.ts"
      ],
      "vite": [
        "./lib/vite/index.d.ts"
      ],
      "webpack": [
        "./lib/webpack/index.d.ts"
      ],
      "rspack": [
        "./lib/rspack/index.d.ts"
      ],
      "rsbuild": [
        "./lib/rsbuild/index.d.ts"
      ],
      "esbuild": [
        "./lib/esbuild/index.d.ts"
      ],
      "rollup": [
        "./lib/rollup/index.d.ts"
      ],
      "jest": [
        "./lib/jest/transformer.d.cts"
      ],
      "metro": [
        "./lib/metro/index.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "confbox": "^0.3.2",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.5.0",
    "@rsbuild/core": ">=1.0.0",
    "@rspack/core": ">=1.0.0",
    "esbuild": ">=0.17.0",
    "jest": ">=29.0.0",
    "metro": ">=0.80.0",
    "rolldown": ">=1.0.0",
    "rollup": ">=3.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "metro": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@noverax/courier": "*",
    "@rsbuild/core": "^2.3.1",
    "@rspack/core": "^2.3.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "metro": "^0.88.0",
    "metro-config": "^0.88.0",
    "rolldown": "^1.3.0",
    "rollup": "^4.68.0",
    "webpack": "^5.112.2"
  }
}
