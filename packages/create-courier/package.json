{
  "name": "@noverax/create-courier",
  "version": "0.5.0",
  "description": "Set Courier up in one command: a typed API layer, its proxy route, Studio, mock data and AI agent access, in a new project or an existing one, for 13 frameworks",
  "keywords": [
    "courier",
    "create",
    "create-app",
    "scaffold",
    "cli",
    "init",
    "typescript",
    "nextjs",
    "nuxt",
    "sveltekit",
    "astro",
    "react-router",
    "express",
    "hono",
    "fastify",
    "nestjs",
    "expo"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/create-courier"
  },
  "homepage": "https://courier.noverax.cloud/docs/create-courier",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "bin": {
    "create-courier": "lib/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./setup": {
      "types": "./lib/set-up-routes.d.ts",
      "import": "./lib/set-up-routes.js",
      "default": "./lib/set-up-routes.js"
    },
    "./engine": {
      "types": "./lib/engine.d.ts",
      "import": "./lib/engine.js",
      "default": "./lib/engine.js"
    },
    "./agent-rules": {
      "types": "./lib/agent-rules.d.ts",
      "import": "./lib/agent-rules.js",
      "default": "./lib/agent-rules.js"
    }
  },
  "typesVersions": {
    "*": {
      "setup": [
        "./lib/set-up-routes.d.ts"
      ],
      "engine": [
        "./lib/engine.d.ts"
      ],
      "agent-rules": [
        "./lib/agent-rules.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@noverax/courier": "0.5.0",
    "citty": "^0.2.2"
  }
}
