{
  "name": "@noverax/courier-build",
  "version": "0.3.1",
  "description": "Courier at build time: loads courier.config the way every Courier tool does, and hands a page's bundle the routes its proxy client may call through a plugin for the app's bundler, with no routes file to generate",
  "keywords": [
    "courier",
    "vite",
    "vite-plugin",
    "bundler",
    "plugin",
    "proxy",
    "routes",
    "typescript",
    "type-safe",
    "api"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/build"
  },
  "homepage": "https://courier.noverax.cloud/docs/proxy-mode/expose",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js",
      "default": "./lib/config/index.js"
    },
    "./vite": {
      "types": "./lib/vite/index.d.ts",
      "import": "./lib/vite/index.js",
      "default": "./lib/vite/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "config": [
        "./lib/config/index.d.ts"
      ],
      "vite": [
        "./lib/vite/index.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "confbox": "^0.3.1",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.3.1",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
