{
  "name": "courier-vscode",
  "displayName": "Courier",
  "description": "Courier Studio in your editor: every endpoint and how its calls went, above each call and in a view of their own; the audit's findings where the code calls; Studio started in a click; and your API offered to VS Code's agent.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#08090a",
    "theme": "dark"
  },
  "version": "0.0.0",
  "private": true,
  "publisher": "noverax",
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://courier.noverax.cloud/docs/studio/editor",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "keywords": [
    "courier",
    "api",
    "http",
    "rest",
    "typescript",
    "codelens",
    "latency",
    "observability",
    "devtools",
    "studio",
    "mcp",
    "agent"
  ],
  "categories": [
    "Visualization",
    "Debuggers",
    "Snippets",
    "AI"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "workspaceContains:**/.courier/studio.json",
    "workspaceContains:**/courier.config.{ts,mts,cts,js,mjs,cjs}",
    "onWebviewPanel:courier.studio",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Courier starts Studio, create-courier and the project's MCP servers from the project's folder, and sends Studio the text of the files you open: a workspace you have not trusted gets none of it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Courier finds Studio through the address file a running Studio writes to the project's folder on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "courier",
          "title": "Courier",
          "icon": "media/courier-mark.svg"
        }
      ]
    },
    "views": {
      "courier": [
        {
          "id": "courier.endpoints",
          "name": "Endpoints",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        },
        {
          "id": "courier.requests",
          "name": "Requests",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        },
        {
          "id": "courier.mocks",
          "name": "Mocks",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "courier.endpoints",
        "contents": "No folder in this workspace has a courier.config yet.\n[Set Up Courier](command:courier.setUp)\nCreate Courier shows its plan first — a typed example API, a mock, and a page that calls it — and changes nothing until you agree. [Read the quick start](https://courier.noverax.cloud/docs/quick-start)",
        "when": "courier.surveyed && !courier.hasProject"
      },
      {
        "view": "courier.endpoints",
        "contents": "Courier Studio is not running for this workspace. Start it to see each endpoint, how its calls went, and where your code calls it.\n[Start Studio](command:courier.startStudio)\nStudio runs in a terminal of its own, through your project's package manager.",
        "when": "courier.surveyed && courier.hasProject && !courier.studioRunning"
      },
      {
        "view": "courier.requests",
        "contents": "Courier Studio is not running for this workspace. Start it to see the requests your app makes, as it makes them.\n[Start Studio](command:courier.startStudio)",
        "when": "courier.surveyed && !courier.studioRunning"
      },
      {
        "view": "courier.mocks",
        "contents": "Courier Studio is not running for this workspace. Start it to see the mocks it runs, their scenarios and the delays and faults set on them.\n[Start Studio](command:courier.startStudio)",
        "when": "courier.surveyed && !courier.studioRunning"
      }
    ],
    "commands": [
      {
        "command": "courier.openInStudio",
        "title": "Open in Courier Studio",
        "category": "Courier",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.openStudioInEditor",
        "title": "Open Studio in Editor",
        "category": "Courier",
        "icon": "$(window)"
      },
      {
        "command": "courier.openStudioInBrowser",
        "title": "Open Studio in Browser",
        "category": "Courier",
        "icon": "$(globe)"
      },
      {
        "command": "courier.startStudio",
        "title": "Start Studio",
        "category": "Courier",
        "icon": "$(play)"
      },
      {
        "command": "courier.setUp",
        "title": "Set Up Courier",
        "category": "Courier",
        "icon": "$(rocket)"
      },
      {
        "command": "courier.refreshHints",
        "title": "Refresh Endpoint Hints",
        "category": "Courier",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.view.openInStudio",
        "title": "Open in Studio",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.view.showFailures",
        "title": "Show Failed Calls in Studio",
        "icon": "$(filter)"
      },
      {
        "command": "courier.view.openLatestFailure",
        "title": "Open the Latest Failure",
        "icon": "$(bug)"
      },
      {
        "command": "courier.view.startStudio",
        "title": "Start Studio",
        "icon": "$(play)"
      },
      {
        "command": "courier.view.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.openStudioPage",
        "title": "Open a Studio Page"
      },
      {
        "command": "courier.request.open",
        "title": "Open in Studio",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.requests.showFailed",
        "title": "Show Failed Requests Only",
        "icon": "$(filter)"
      },
      {
        "command": "courier.requests.showAll",
        "title": "Show All Requests",
        "icon": "$(filter-filled)"
      },
      {
        "command": "courier.requests.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.mocks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.mock.scenario",
        "title": "Switch to This Scenario",
        "icon": "$(check)"
      },
      {
        "command": "courier.mock.delay",
        "title": "Delay Answers…",
        "icon": "$(watch)"
      },
      {
        "command": "courier.mock.faults",
        "title": "Fail Some Answers…",
        "icon": "$(flame)"
      },
      {
        "command": "courier.mock.stopFaults",
        "title": "Stop Delays and Faults",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "courier.view.openInStudio",
          "when": "false"
        },
        {
          "command": "courier.view.showFailures",
          "when": "false"
        },
        {
          "command": "courier.view.openLatestFailure",
          "when": "false"
        },
        {
          "command": "courier.view.startStudio",
          "when": "false"
        },
        {
          "command": "courier.view.refresh",
          "when": "false"
        },
        {
          "command": "courier.openStudioPage",
          "when": "false"
        },
        {
          "command": "courier.request.open",
          "when": "false"
        },
        {
          "command": "courier.requests.showFailed",
          "when": "false"
        },
        {
          "command": "courier.requests.showAll",
          "when": "false"
        },
        {
          "command": "courier.requests.refresh",
          "when": "false"
        },
        {
          "command": "courier.mocks.refresh",
          "when": "false"
        },
        {
          "command": "courier.mock.scenario",
          "when": "false"
        },
        {
          "command": "courier.mock.delay",
          "when": "false"
        },
        {
          "command": "courier.mock.faults",
          "when": "false"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "courier.openStudioInEditor",
          "when": "view == courier.endpoints && courier.studioRunning",
          "group": "navigation@0"
        },
        {
          "command": "courier.startStudio",
          "when": "view == courier.endpoints && courier.hasProject && !courier.studioRunning",
          "group": "navigation@1"
        },
        {
          "command": "courier.view.refresh",
          "when": "view == courier.endpoints",
          "group": "navigation@2"
        },
        {
          "command": "courier.requests.showFailed",
          "when": "view == courier.requests && !courier.requests.failedOnly",
          "group": "navigation@1"
        },
        {
          "command": "courier.requests.showAll",
          "when": "view == courier.requests && courier.requests.failedOnly",
          "group": "navigation@1"
        },
        {
          "command": "courier.requests.refresh",
          "when": "view == courier.requests",
          "group": "navigation@2"
        },
        {
          "command": "courier.mocks.refresh",
          "when": "view == courier.mocks",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "courier.view.openLatestFailure",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint.*\\.latest/",
          "group": "inline@1"
        },
        {
          "command": "courier.view.openInStudio",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(endpoint|project\\.running)/",
          "group": "inline@2"
        },
        {
          "command": "courier.view.startStudio",
          "when": "view == courier.endpoints && viewItem == courier.project.stopped",
          "group": "inline@1"
        },
        {
          "command": "courier.view.openInStudio",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(endpoint|project\\.running)/",
          "group": "studio@1"
        },
        {
          "command": "courier.view.showFailures",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint\\.failed/",
          "group": "studio@2"
        },
        {
          "command": "courier.view.openLatestFailure",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint.*\\.latest/",
          "group": "studio@3"
        },
        {
          "command": "courier.view.startStudio",
          "when": "view == courier.endpoints && viewItem == courier.project.stopped",
          "group": "studio@1"
        },
        {
          "command": "courier.mock.delay",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "inline@1"
        },
        {
          "command": "courier.mock.faults",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "inline@2"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "view == courier.mocks && viewItem == courier.mock.faulty",
          "group": "inline@3"
        },
        {
          "command": "courier.mock.delay",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "mock@1"
        },
        {
          "command": "courier.mock.faults",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "mock@2"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "view == courier.mocks && viewItem == courier.mock.faulty",
          "group": "mock@3"
        },
        {
          "command": "courier.mock.scenario",
          "when": "view == courier.mocks && viewItem == courier.scenario",
          "group": "inline@1"
        },
        {
          "command": "courier.request.open",
          "when": "view == courier.requests && viewItem == courier.request",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Courier",
      "properties": {
        "courier.hints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show above each call to an endpoint how its calls went in Courier Studio."
        },
        "courier.hints.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often the hints are brought up to date while the window has focus, in seconds."
        },
        "courier.studio.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Courier Studio's address, when it runs for a project outside this workspace: `http://localhost:6280`. Left empty, the extension finds the Studio each project in the workspace runs. Only an address on this machine is used — the extension sends Studio the text of the files you open — and only from your user settings, never a workspace's."
        },
        "courier.studio.openIn": {
          "type": "string",
          "enum": [
            "editor",
            "browser"
          ],
          "enumDescriptions": [
            "In a tab of the editor's own, beside the code",
            "In the browser"
          ],
          "default": "editor",
          "description": "Where Courier Studio's pages open — an endpoint, a request, the audit — from the hints, the Courier view and the status bar."
        },
        "courier.audit.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Mark the findings of Studio's audit — an N+1 pattern, a timeout risk, a write without credentials — at the calls they concern, in the Problems panel too."
        },
        "courier.agents.mcpServers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer VS Code's agent the MCP servers of each Courier project that has their package installed: its API as tools (`@noverax/courier-mcp`), and its running Studio (`@noverax/courier-studio mcp`)."
        }
      }
    },
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/define.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/define.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/call.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/call.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/call.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/call.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "courier.start",
        "title": "Get Started with Courier",
        "description": "From a project without Courier to every endpoint's calls in your editor, and your API in your agent's hands.",
        "steps": [
          {
            "id": "setUp",
            "title": "Set Courier up",
            "description": "Create Courier adds a typed example API, a mock, and a page that calls it, with the route your framework serves it through. It shows the plan first, and changes nothing until you agree.\n[Set Up Courier](command:courier.setUp)",
            "media": {
              "markdown": "media/walkthrough/set-up.md"
            },
            "completionEvents": [
              "onContext:courier.hasProject"
            ]
          },
          {
            "id": "startStudio",
            "title": "Start Courier Studio",
            "description": "Studio records every call your app makes, and runs the mocks. It starts in a terminal of its own, through your project's package manager.\n[Start Studio](command:courier.startStudio)",
            "media": {
              "image": {
                "light": "media/walkthrough/view-light.png",
                "dark": "media/walkthrough/view-dark.png",
                "hc": "media/walkthrough/view-dark.png",
                "hcLight": "media/walkthrough/view-light.png"
              },
              "altText": "The Courier view: the shop's endpoints grouped as the client names them, each with its calls, failures and p95."
            },
            "completionEvents": [
              "onContext:courier.studioRunning"
            ]
          },
          {
            "id": "hints",
            "title": "See how each call went",
            "description": "Above each call to an endpoint: how many calls it had, how many failed and how long nineteen in twenty took. Hover it for the statuses and the latest failure, and open that request in Studio's inspector.",
            "media": {
              "image": {
                "light": "media/walkthrough/hover-light.png",
                "dark": "media/walkthrough/hover-dark.png",
                "hc": "media/walkthrough/hover-dark.png",
                "hcLight": "media/walkthrough/hover-light.png"
              },
              "altText": "A hover over a call: the endpoint's calls, p50 and p95, statuses and its latest failure, with links into Studio."
            },
            "completionEvents": [
              "onView:courier.endpoints"
            ]
          },
          {
            "id": "agents",
            "title": "Give your agent the API",
            "description": "Each project that has @noverax/courier-mcp installed is offered to VS Code's agent: the endpoints its agents policy allows, as tools. With Studio installed, the agent reads the requests Studio recorded too.\n[Read about agents in your editor](https://courier.noverax.cloud/docs/agents/editor)",
            "media": {
              "markdown": "media/walkthrough/agent-servers.md"
            },
            "completionEvents": [
              "onLink:https://courier.noverax.cloud/docs/agents/editor"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "courier",
        "label": "Courier"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test:editor": "node tests/editor/run-in-editor.mjs",
    "prepackage": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "package": "vsce package --no-dependencies --out dist/courier.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  }
}
