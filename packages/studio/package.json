{
  "name": "@noverax/courier-studio",
  "version": "0.3.0",
  "description": "Courier Studio: see every request your app makes — a live timeline, inspector, playground, OpenAPI import, audit and mock servers, running locally and off in production builds",
  "keywords": [
    "courier",
    "studio",
    "devtools",
    "debugging",
    "inspector",
    "network",
    "api",
    "playground",
    "openapi",
    "mock-server",
    "typescript"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/studio"
  },
  "homepage": "https://courier.noverax.cloud/studio",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": [
    "./lib/cli.js",
    "./lib/format-worker.js",
    "./lib/job-memory-watch.js",
    "./lib/mock-worker.js",
    "./lib/spec-worker.js"
  ],
  "bin": {
    "courier-studio": "lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./vite": {
      "types": "./lib/vite.d.ts",
      "import": "./lib/vite.js",
      "default": "./lib/vite.js"
    },
    "./next": {
      "types": "./lib/next.d.ts",
      "import": "./lib/next.js",
      "default": "./lib/next.js"
    },
    "./nuxt": {
      "types": "./lib/nuxt.d.ts",
      "import": "./lib/nuxt.js",
      "default": "./lib/nuxt.js"
    },
    "./webpack": {
      "types": "./lib/webpack.d.ts",
      "import": "./lib/webpack.js",
      "default": "./lib/webpack.js"
    },
    "./esbuild": {
      "types": "./lib/esbuild.d.ts",
      "import": "./lib/esbuild.js",
      "default": "./lib/esbuild.js"
    },
    "./rollup": {
      "types": "./lib/rollup.d.ts",
      "import": "./lib/rollup.js",
      "default": "./lib/rollup.js"
    },
    "./astro": {
      "types": "./lib/astro.d.ts",
      "import": "./lib/astro.js",
      "default": "./lib/astro.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js",
      "default": "./lib/react.js"
    },
    "./vue": {
      "types": "./lib/vue.d.ts",
      "import": "./lib/vue.js",
      "default": "./lib/vue.js"
    },
    "./sveltekit": {
      "types": "./lib/sveltekit.d.ts",
      "import": "./lib/sveltekit.js",
      "default": "./lib/sveltekit.js"
    },
    "./remix": {
      "types": "./lib/remix.d.ts",
      "import": "./lib/remix.js",
      "default": "./lib/remix.js"
    },
    "./solid": {
      "types": "./lib/solid.d.ts",
      "import": "./lib/solid.js",
      "default": "./lib/solid.js"
    },
    "./angular": {
      "types": "./lib/angular.d.ts",
      "import": "./lib/angular.js",
      "default": "./lib/angular.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./lib/server.d.ts"
      ],
      "vite": [
        "./lib/vite.d.ts"
      ],
      "next": [
        "./lib/next.d.ts"
      ],
      "nuxt": [
        "./lib/nuxt.d.ts"
      ],
      "webpack": [
        "./lib/webpack.d.ts"
      ],
      "esbuild": [
        "./lib/esbuild.d.ts"
      ],
      "rollup": [
        "./lib/rollup.d.ts"
      ],
      "astro": [
        "./lib/astro.d.ts"
      ],
      "react": [
        "./lib/react.d.ts"
      ],
      "vue": [
        "./lib/vue.d.ts"
      ],
      "sveltekit": [
        "./lib/sveltekit.d.ts"
      ],
      "remix": [
        "./lib/remix.d.ts"
      ],
      "solid": [
        "./lib/solid.d.ts"
      ],
      "angular": [
        "./lib/angular.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "ui/dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier-cli": "0.3.0",
    "@noverax/courier-mcp": "0.3.0",
    "@noverax/courier-studio-core": "0.3.0",
    "citty": "^0.2.2",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "open": "^11.0.4",
    "oxc-parser": "0.153.0",
    "socket.io": "^4.8.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.3.0",
    "@noverax/courier-mock": "^0.3.0",
    "next": ">=14.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@noverax/courier-mock": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noverax/courier": "*",
    "@noverax/courier-mock": "*",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/compression": "^1.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "rollup": "^4.64.7"
  }
}
