{
  "name": "@noverax/courier",
  "version": "0.0.0",
  "description": "Type-safe HTTP client with dual-mode transport, middleware chain, and runtime validation",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js"
    },
    "./define": {
      "types": "./lib/define/index.d.ts",
      "import": "./lib/define/index.js"
    },
    "./middleware": {
      "types": "./lib/middleware/index.d.ts",
      "import": "./lib/middleware/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "import": "./lib/node.js"
    },
    "./fetch": {
      "types": "./lib/fetch/index.d.ts",
      "import": "./lib/fetch/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "import": "./lib/testing/index.js"
    },
    "./realtime": {
      "types": "./lib/realtime/index.d.ts",
      "import": "./lib/realtime/index.js"
    },
    "./internal-streams": {
      "types": "./lib/internal-streams/index.d.ts",
      "import": "./lib/internal-streams/index.js"
    },
    "./announce": {
      "types": "./lib/announce/index.d.ts",
      "import": "./lib/announce/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  }
}
