{
  "name": "@noverax/courier-astro",
  "version": "0.5.0",
  "description": "Astro adapter for Courier: an API endpoint that proxies typed calls to any backend, with the user's session in pages, endpoints and actions",
  "keywords": [
    "courier",
    "astro",
    "ssr",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/astro"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/astro",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./request-context": {
      "types": "./lib/request-context.d.ts",
      "import": "./lib/request-context.js",
      "default": "./lib/request-context.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "import": "./lib/plugin.js",
      "default": "./lib/plugin.js"
    }
  },
  "typesVersions": {
    "*": {
      "request-context": [
        "./lib/request-context.d.ts"
      ],
      "plugin": [
        "./lib/plugin.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.5.0",
    "@noverax/courier-build": "^0.5.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@noverax/courier-build": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*",
    "@noverax/courier-build": "*"
  }
}
