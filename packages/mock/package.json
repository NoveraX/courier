{
  "name": "@noverax/courier-mock",
  "version": "0.0.0",
  "description": "Type-safe mock server with stateful store, scenarios, chaos engineering, and visual builder for @noverax/courier",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/mock"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "import": "./lib/testing.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js"
    },
    "./contract": {
      "types": "./lib/contract/index.d.ts",
      "import": "./lib/contract/index.js"
    },
    "./managed/worker-entry": {
      "types": "./lib/managed/worker-entry.d.ts",
      "import": "./lib/managed/worker-entry.js"
    },
    "./meta-worker": {
      "types": "./lib/auto/meta-worker.d.ts",
      "import": "./lib/auto/meta-worker.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.19.0 || ^2.0.0",
    "hono": ">=4",
    "socket.io-client": ">=4",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "socket.io-client": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  }
}
