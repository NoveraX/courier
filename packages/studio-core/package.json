{
  "name": "@noverax/courier-studio-core",
  "version": "0.2.0",
  "description": "Courier Studio's runtime: attachRuntime registers your config's sources and, in development, streams every call your server and browser make to Studio",
  "keywords": [
    "courier",
    "studio",
    "devtools",
    "instrumentation",
    "runtime",
    "observability",
    "typescript"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/studio-core"
  },
  "homepage": "https://courier.noverax.cloud/docs/studio/overview",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "browser": "./lib/runtime/browser.js",
      "import": "./lib/runtime/index.js",
      "default": "./lib/runtime/index.js"
    },
    "./config": {
      "types": "./lib/runtime/load-config.d.ts",
      "import": "./lib/runtime/load-config.js",
      "default": "./lib/runtime/load-config.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "./lib/runtime/index.d.ts"
      ],
      "config": [
        "./lib/runtime/load-config.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "confbox": "^0.3.1",
    "jiti": "^2.7.0",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.2.0"
  },
  "devDependencies": {
    "@noverax/courier": "*",
    "esbuild": "^0.28.2"
  }
}
