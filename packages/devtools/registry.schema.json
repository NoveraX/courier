{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus Registry",
  "description": "Configuration file for @noverax/nexus-devtools API registry",
  "type": "object",
  "required": ["sources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "object",
      "description": "Map of source name → source configuration",
      "additionalProperties": {
        "$ref": "#/$defs/RegistrySource"
      }
    },
    "scanPaths": {
      "type": "array",
      "description": "Directories to scan for hand-written APIs (default: [\"src/api\"])",
      "items": { "type": "string" }
    },
    "scanIgnore": {
      "type": "array",
      "description": "Glob patterns to ignore when scanning",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "RegistrySource": {
      "type": "object",
      "required": ["specUrl", "importType", "specHash", "options", "userModified"],
      "additionalProperties": false,
      "properties": {
        "specUrl": {
          "type": "string",
          "description": "URL or local file path to the OpenAPI spec"
        },
        "importType": {
          "type": "string",
          "enum": ["url", "file", "raw"],
          "description": "How the spec was imported — determines update check behavior"
        },
        "specHash": {
          "type": "string",
          "description": "SHA-256 hash (32 hex chars) for change detection",
          "pattern": "^[a-f0-9]{32}$"
        },
        "options": {
          "$ref": "#/$defs/GenerateOptions"
        },
        "userModified": {
          "type": "array",
          "description": "Endpoint names that were user-modified at last sync",
          "items": { "type": "string" }
        }
      }
    },
    "GenerateOptions": {
      "type": "object",
      "required": [
        "sourceName",
        "outputDir",
        "validation",
        "groupBy",
        "generateTypes",
        "generateSchemas",
        "addAuthMiddleware",
        "includeComments",
        "generateClient"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceName": {
          "type": "string",
          "description": "Source name for the defineApi call"
        },
        "outputDir": {
          "type": "string",
          "description": "Output directory for generated files"
        },
        "validation": {
          "type": "string",
          "enum": ["zod", "valibot", "arktype", "none"],
          "description": "Validation library to use"
        },
        "groupBy": {
          "type": "string",
          "enum": ["tag", "path", "single"],
          "description": "Endpoint grouping strategy"
        },
        "generateTypes": {
          "type": "boolean",
          "description": "Generate TypeScript types"
        },
        "generateSchemas": {
          "type": "boolean",
          "description": "Generate validation schemas"
        },
        "addAuthMiddleware": {
          "type": "boolean",
          "description": "Add auth middleware to secured endpoints"
        },
        "includeComments": {
          "type": "boolean",
          "description": "Include JSDoc comments from OpenAPI descriptions"
        },
        "generateClient": {
          "type": "string",
          "enum": ["direct", "proxy", "both", "none"],
          "description": "Client generation mode"
        }
      }
    }
  }
}
