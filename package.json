{
  "name": "@noverax/courier-monorepo",
  "private": true,
  "description": "Type-safe HTTP client with dual-mode transport, middleware chain, and runtime validation",
  "author": "NoveraX",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "packages/studio/ui"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git"
  },
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "homepage": "https://courier.noverax.cloud",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hono/node-server": "^2.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "fastify": "^5.12.5",
    "h3": "^2.0.1-rc.32",
    "hono": "^4.13.8",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write packages/",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write packages/",
    "check": "biome check packages/",
    "check:names": "node scripts/check-name-conflicts.mjs",
    "check:names:test": "vitest run scripts/check-name-conflicts.test.mjs",
    "release": "HUSKY=0 semantic-release",
    "prepare": "husky"
  },
  "overrides": {
    "h3": "$h3"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": "biome check --write --no-errors-on-unmatched"
  }
}
