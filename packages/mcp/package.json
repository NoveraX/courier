{
  "name": "@noverax/courier-mcp",
  "version": "0.1.0",
  "description": "Your Courier API as tools for AI agents: an MCP server over stdio and Streamable HTTP that offers only the endpoints you mark, through your middleware, with a person confirming what cannot be undone",
  "keywords": [
    "courier",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agents",
    "agents",
    "llm",
    "tools",
    "typescript",
    "type-safe",
    "api"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://courier.noverax.cloud/mcp",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "courier-mcp": "lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/internal.d.ts",
      "import": "./lib/internal.js",
      "default": "./lib/internal.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier-studio-core": "0.1.0",
    "citty": "^0.2.2"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noverax/courier": "*"
  }
}
