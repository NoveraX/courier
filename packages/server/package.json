{
  "name": "@noverax/courier-server",
  "version": "0.0.0",
  "description": "Standalone HTTP + WebSocket server for @noverax/courier \u2014 proxy handler for Next.js and serverless environments",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "courier-server": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*",
    "citty": "^0.2.2"
  },
  "peerDependencies": {
    "ws": ">=8"
  }
}
