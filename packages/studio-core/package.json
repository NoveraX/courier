{
  "name": "@noverax/courier-studio-core",
  "version": "0.0.0",
  "description": "Studio instrumentation core \u2014 EventBus, event types, and Socket.IO connector for @noverax/courier",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "devtools",
    "studio",
    "instrumentation",
    "runtime"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/studio-core"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime/index.d.ts",
      "import": "./lib/runtime/index.js"
    },
    "./config": {
      "types": "./lib/runtime/load-config.d.ts",
      "import": "./lib/runtime/load-config.js"
    }
  },
  "browser": {
    "./lib/runtime/load-config.js": false
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*",
    "confbox": "^0.3.1",
    "jiti": "^2.6.1"
  },
  "peerDependencies": {
    "socket.io-client": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  }
}
