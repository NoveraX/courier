{
  "name": "@noverax/nexus-monorepo",
  "private": true,
  "description": "Type-safe HTTP client with dual-mode transport, middleware chain, and runtime validation",
  "author": "NoveraX",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/nexus.git"
  },
  "bugs": {
    "url": "https://github.com/NoveraX/nexus/issues"
  },
  "homepage": "https://nexus.noverax.cloud",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.4.6",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@hono/node-server": "^1.19.11",
    "@rolldown/plugin-babel": "^0.2.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-query": "^5.90.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "fastify": "^5.8.2",
    "h3": "^2.0.1-rc.16",
    "hono": "^4.12.5",
    "husky": "^9.1.7",
    "ioredis": "^5.10.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semantic-release": "^25.0.3",
    "socket.io-client": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3",
    "valibot": "^1.2.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --write packages/",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write packages/",
    "check": "biome check packages/",
    "check:names": "node scripts/check-name-conflicts.mjs",
    "check:names:test": "vitest run scripts/check-name-conflicts.test.mjs",
    "release": "HUSKY=0 semantic-release",
    "prepare": "husky"
  },
  "overrides": {
    "h3": "$h3"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": "biome check --write --no-errors-on-unmatched"
  }
}
