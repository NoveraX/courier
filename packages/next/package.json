{
  "name": "@noverax/courier-next",
  "version": "0.3.1",
  "description": "Next.js adapter for Courier: one App Router route that proxies typed calls to any backend, createAction for Server Actions, and the user's session in Server Components and Route Handlers",
  "keywords": [
    "courier",
    "nextjs",
    "next",
    "app-router",
    "server-actions",
    "server-components",
    "route-handlers",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session",
    "csrf"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/next"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/nextjs",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./actions": {
      "types": "./lib/actions.d.ts",
      "import": "./lib/actions.js",
      "default": "./lib/actions.js"
    },
    "./pages": {
      "types": "./lib/pages.d.ts",
      "import": "./lib/pages.js",
      "default": "./lib/pages.js"
    },
    "./middleware": {
      "types": "./lib/middleware.d.ts",
      "import": "./lib/middleware.js",
      "default": "./lib/middleware.js"
    }
  },
  "typesVersions": {
    "*": {
      "actions": [
        "./lib/actions.d.ts"
      ],
      "pages": [
        "./lib/pages.d.ts"
      ],
      "middleware": [
        "./lib/middleware.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.3.1",
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
