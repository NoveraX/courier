{
  "name": "@noverax/courier-angular",
  "version": "0.4.0",
  "description": "Courier for Angular: builders that hand a page's bundle the routes its proxy client may call, built from courier.config, with no routes file to generate",
  "keywords": [
    "courier",
    "angular",
    "angular-builder",
    "esbuild",
    "proxy",
    "routes",
    "typescript",
    "type-safe",
    "api"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/angular"
  },
  "homepage": "https://courier.noverax.cloud/docs/proxy-mode/expose",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "builders": "./builders.json",
  "exports": {
    "./package.json": "./package.json",
    "./builders.json": "./builders.json"
  },
  "files": [
    "lib",
    "builders.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@noverax/courier-build": "0.4.0"
  },
  "peerDependencies": {
    "@angular-devkit/architect": ">=0.2000.0",
    "@angular/build": ">=20.0.0",
    "@noverax/courier": "^0.4.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2202.5",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@noverax/courier": "*",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
