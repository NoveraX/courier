{
  "name": "@noverax/courier-nestjs",
  "version": "0.0.0",
  "description": "NestJS adapter for @noverax/courier \u2014 module + middleware handler",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*"
  },
  "peerDependencies": {
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
