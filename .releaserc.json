{
  "branches": [
    "master",
    {
      "name": "beta",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "breaking": true,
            "release": "minor"
          },
          {
            "scope": "docs",
            "release": false
          },
          {
            "scope": "site",
            "release": false
          },
          {
            "scope": "landing",
            "release": false
          },
          {
            "scope": "examples",
            "release": false
          },
          {
            "scope": "scripts",
            "release": false
          },
          {
            "scope": "release",
            "release": false
          }
        ]
      }
    ],
    [
      "./scripts/release-notes.mjs",
      {
        "preset": "conventionalcommits",
        "leaveOut": ["docs", "site", "landing", "examples", "scripts", "release"]
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyConditionsCmd": "npx tsx scripts/check-npm-publishing.ts",
        "prepareCmd": "npx tsx scripts/release.ts prepare ${nextRelease.version} && node scripts/check-packages.mjs --release",
        "publishCmd": "npx tsx scripts/release.ts publish ${nextRelease.version} ${nextRelease.channel || 'latest'}"
      }
    ],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "package-lock.json", "packages/*/package.json"],
        "message": "chore(release): 🔧 v${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ]
  ]
}
