{
  "name": "courier-vscode",
  "displayName": "Courier for VS Code",
  "description": "Courier Studio in your editor: every endpoint and how its calls went, above each call and in views of their own; Studio in a tab beside your code; from a call to its endpoint and back; requests and mocks live; new endpoints written for you; recorded calls as tests; @courier in the chat; Courier's own file icons, through Courier File Icons, which comes with it; and your API offered to VS Code's agent.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#08090a",
    "theme": "dark"
  },
  "version": "0.1.0",
  "private": true,
  "publisher": "noverax",
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://courier.noverax.cloud/docs/studio/editor",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "keywords": [
    "courier",
    "api",
    "http",
    "rest",
    "typescript",
    "codelens",
    "latency",
    "observability",
    "devtools",
    "studio",
    "mcp",
    "agent",
    "chat"
  ],
  "categories": [
    "Visualization",
    "Debuggers",
    "Snippets",
    "AI",
    "Chat"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "workspaceContains:**/.courier/studio.json",
    "workspaceContains:**/courier.config.{ts,mts,cts,js,mjs,cjs}",
    "onWebviewPanel:courier.studio",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:astro"
  ],
  "main": "./dist/extension.cjs",
  "extensionPack": [
    "noverax.courier-file-icons"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Courier starts Studio, create-courier and the project's MCP servers from the project's folder, and sends Studio the text of the files you open: a workspace you have not trusted gets none of it."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Courier finds Studio through the address file a running Studio writes to the project's folder on disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "courier",
          "title": "Courier",
          "icon": "media/courier-mark.svg"
        }
      ]
    },
    "views": {
      "courier": [
        {
          "id": "courier.endpoints",
          "name": "Endpoints",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        },
        {
          "id": "courier.requests",
          "name": "Requests",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        },
        {
          "id": "courier.mocks",
          "name": "Mocks",
          "icon": "media/courier-mark.svg",
          "contextualTitle": "Courier"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "courier.endpoints",
        "contents": "No folder in this workspace has a courier.config yet.\n[Set Up Courier](command:courier.setUp)\nCreate Courier shows its plan first — a typed example API, a mock, and a page that calls it — and changes nothing until you agree. [Read the quick start](https://courier.noverax.cloud/docs/quick-start)",
        "when": "courier.surveyed && !courier.hasProject"
      },
      {
        "view": "courier.endpoints",
        "contents": "Courier Studio is not running for this workspace. Start it to see each endpoint, how its calls went, and where your code calls it.\n[Start Studio](command:courier.startStudio)\nStudio runs in a terminal of its own, through your project's package manager.",
        "when": "courier.surveyed && courier.hasProject && !courier.studioRunning"
      },
      {
        "view": "courier.requests",
        "contents": "Courier Studio is not running for this workspace. Start it to see the requests your app makes, as it makes them.\n[Start Studio](command:courier.startStudio)",
        "when": "courier.surveyed && !courier.studioRunning"
      },
      {
        "view": "courier.mocks",
        "contents": "Courier Studio is not running for this workspace. Start it to see the mocks it runs, their scenarios and the delays and faults set on them.\n[Start Studio](command:courier.startStudio)",
        "when": "courier.surveyed && !courier.studioRunning"
      }
    ],
    "commands": [
      {
        "command": "courier.openInStudio",
        "title": "Open in Courier Studio",
        "category": "Courier",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.openStudioInEditor",
        "title": "Open Studio in Editor",
        "category": "Courier",
        "icon": "$(window)"
      },
      {
        "command": "courier.openStudioInBrowser",
        "title": "Open Studio in Browser",
        "category": "Courier",
        "icon": "$(globe)"
      },
      {
        "command": "courier.startStudio",
        "title": "Start Studio",
        "category": "Courier",
        "icon": "$(play)"
      },
      {
        "command": "courier.setUp",
        "title": "Set Up Courier",
        "category": "Courier",
        "icon": "$(rocket)"
      },
      {
        "command": "courier.newEndpoint",
        "title": "New Endpoint…",
        "category": "Courier",
        "icon": "$(add)"
      },
      {
        "command": "courier.importApi",
        "title": "Import an API…",
        "category": "Courier",
        "icon": "$(cloud-download)"
      },
      {
        "command": "courier.showOpenApi",
        "title": "Show OpenAPI Document…",
        "category": "Courier",
        "icon": "$(file-code)"
      },
      {
        "command": "courier.checkApiChanges",
        "title": "Check API Changes…",
        "category": "Courier",
        "icon": "$(git-compare)"
      },
      {
        "command": "courier.refreshHints",
        "title": "Refresh Endpoint Hints",
        "category": "Courier",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.view.openInStudio",
        "title": "Open in Studio",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.view.showFailures",
        "title": "Show Failed Calls in Studio",
        "icon": "$(filter)"
      },
      {
        "command": "courier.view.openLatestFailure",
        "title": "Open the Latest Failure",
        "icon": "$(bug)"
      },
      {
        "command": "courier.view.startStudio",
        "title": "Start Studio",
        "icon": "$(play)"
      },
      {
        "command": "courier.view.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.openStudioPage",
        "title": "Open a Studio Page"
      },
      {
        "command": "courier.request.open",
        "title": "Open in Studio",
        "icon": "$(link-external)"
      },
      {
        "command": "courier.requests.showFailed",
        "title": "Show Failed Requests Only",
        "icon": "$(filter)"
      },
      {
        "command": "courier.requests.showAll",
        "title": "Show All Requests",
        "icon": "$(filter-filled)"
      },
      {
        "command": "courier.requests.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.mocks.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "courier.mock.scenario",
        "title": "Switch to This Scenario",
        "icon": "$(check)"
      },
      {
        "command": "courier.mock.delay",
        "title": "Delay Answers…",
        "icon": "$(watch)"
      },
      {
        "command": "courier.mock.faults",
        "title": "Fail Some Answers…",
        "icon": "$(flame)"
      },
      {
        "command": "courier.mock.stopFaults",
        "title": "Stop Delays and Faults",
        "icon": "$(debug-stop)"
      },
      {
        "command": "courier.view.newEndpoint",
        "title": "New Endpoint…",
        "icon": "$(add)"
      },
      {
        "command": "courier.showLog",
        "title": "Show Log",
        "category": "Courier",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "courier.view.openInStudio",
          "when": "false"
        },
        {
          "command": "courier.view.showFailures",
          "when": "false"
        },
        {
          "command": "courier.view.openLatestFailure",
          "when": "false"
        },
        {
          "command": "courier.view.startStudio",
          "when": "false"
        },
        {
          "command": "courier.view.refresh",
          "when": "false"
        },
        {
          "command": "courier.openStudioPage",
          "when": "false"
        },
        {
          "command": "courier.request.open",
          "when": "false"
        },
        {
          "command": "courier.requests.showFailed",
          "when": "false"
        },
        {
          "command": "courier.requests.showAll",
          "when": "false"
        },
        {
          "command": "courier.requests.refresh",
          "when": "false"
        },
        {
          "command": "courier.mocks.refresh",
          "when": "false"
        },
        {
          "command": "courier.mock.scenario",
          "when": "false"
        },
        {
          "command": "courier.mock.delay",
          "when": "false"
        },
        {
          "command": "courier.mock.faults",
          "when": "false"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "false"
        },
        {
          "command": "courier.view.newEndpoint",
          "when": "false"
        },
        {
          "command": "courier.newEndpoint",
          "when": "courier.studioRunning"
        },
        {
          "command": "courier.importApi",
          "when": "courier.hasProject"
        },
        {
          "command": "courier.showOpenApi",
          "when": "courier.studioRunning"
        },
        {
          "command": "courier.checkApiChanges",
          "when": "courier.hasProject"
        }
      ],
      "view/title": [
        {
          "command": "courier.openStudioInEditor",
          "when": "view == courier.endpoints && courier.studioRunning",
          "group": "navigation@0"
        },
        {
          "command": "courier.startStudio",
          "when": "view == courier.endpoints && courier.hasProject && !courier.studioRunning",
          "group": "navigation@1"
        },
        {
          "command": "courier.view.refresh",
          "when": "view == courier.endpoints",
          "group": "navigation@2"
        },
        {
          "command": "courier.requests.showFailed",
          "when": "view == courier.requests && !courier.requests.failedOnly",
          "group": "navigation@1"
        },
        {
          "command": "courier.requests.showAll",
          "when": "view == courier.requests && courier.requests.failedOnly",
          "group": "navigation@1"
        },
        {
          "command": "courier.requests.refresh",
          "when": "view == courier.requests",
          "group": "navigation@2"
        },
        {
          "command": "courier.mocks.refresh",
          "when": "view == courier.mocks",
          "group": "navigation@2"
        },
        {
          "command": "courier.newEndpoint",
          "when": "view == courier.endpoints",
          "group": "courier@1"
        },
        {
          "command": "courier.importApi",
          "when": "view == courier.endpoints",
          "group": "courier@2"
        },
        {
          "command": "courier.showOpenApi",
          "when": "view == courier.endpoints",
          "group": "courier@3"
        },
        {
          "command": "courier.checkApiChanges",
          "when": "view == courier.endpoints",
          "group": "courier@4"
        },
        {
          "command": "courier.openStudioInBrowser",
          "when": "view == courier.endpoints",
          "group": "courier@5"
        },
        {
          "command": "courier.showLog",
          "when": "view == courier.endpoints",
          "group": "courier@7"
        }
      ],
      "view/item/context": [
        {
          "command": "courier.view.openLatestFailure",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint.*\\.latest/",
          "group": "inline@1"
        },
        {
          "command": "courier.view.openInStudio",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(endpoint|project\\.running)/",
          "group": "inline@2"
        },
        {
          "command": "courier.view.startStudio",
          "when": "view == courier.endpoints && viewItem == courier.project.stopped",
          "group": "inline@1"
        },
        {
          "command": "courier.view.openInStudio",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(endpoint|project\\.running)/",
          "group": "studio@1"
        },
        {
          "command": "courier.view.showFailures",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint\\.failed/",
          "group": "studio@2"
        },
        {
          "command": "courier.view.openLatestFailure",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.endpoint.*\\.latest/",
          "group": "studio@3"
        },
        {
          "command": "courier.view.startStudio",
          "when": "view == courier.endpoints && viewItem == courier.project.stopped",
          "group": "studio@1"
        },
        {
          "command": "courier.mock.delay",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "inline@1"
        },
        {
          "command": "courier.mock.faults",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "inline@2"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "view == courier.mocks && viewItem == courier.mock.faulty",
          "group": "inline@3"
        },
        {
          "command": "courier.mock.delay",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "mock@1"
        },
        {
          "command": "courier.mock.faults",
          "when": "view == courier.mocks && viewItem =~ /^courier\\.mock/",
          "group": "mock@2"
        },
        {
          "command": "courier.mock.stopFaults",
          "when": "view == courier.mocks && viewItem == courier.mock.faulty",
          "group": "mock@3"
        },
        {
          "command": "courier.mock.scenario",
          "when": "view == courier.mocks && viewItem == courier.scenario",
          "group": "inline@1"
        },
        {
          "command": "courier.request.open",
          "when": "view == courier.requests && viewItem == courier.request",
          "group": "inline@1"
        },
        {
          "command": "courier.view.newEndpoint",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(source|group)$/",
          "group": "inline@1"
        },
        {
          "command": "courier.view.newEndpoint",
          "when": "view == courier.endpoints && viewItem =~ /^courier\\.(source|group)$/",
          "group": "edit@1"
        }
      ],
      "editor/context": [
        {
          "command": "courier.newEndpoint",
          "when": "courier.studioRunning && resourceLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "1_modification@9"
        }
      ]
    },
    "configuration": {
      "title": "Courier",
      "properties": {
        "courier.hints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show above each call to an endpoint how its calls went in Courier Studio."
        },
        "courier.hints.refreshSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "description": "How often the hints are brought up to date while the window has focus, in seconds."
        },
        "courier.hints.style": {
          "type": "string",
          "enum": [
            "codeLens",
            "inlay"
          ],
          "enumDescriptions": [
            "A line of its own above each call.",
            "At the end of the call's line, in the code's own lines; the editor's inlay hints must be on."
          ],
          "default": "codeLens",
          "description": "Where the hints over each call to an endpoint go."
        },
        "courier.studio.url": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Courier Studio's address, when it runs for a project outside this workspace: `http://localhost:6280`. Left empty, the extension finds the Studio each project in the workspace runs. Only an address on this machine is used — the extension sends Studio the text of the files you open — and only from your user settings, never a workspace's."
        },
        "courier.studio.openIn": {
          "type": "string",
          "enum": [
            "editor",
            "browser"
          ],
          "enumDescriptions": [
            "In a tab of the editor's own, beside the code",
            "In the browser"
          ],
          "default": "editor",
          "description": "Where Courier Studio's pages open — an endpoint, a request, the audit — from the hints, the Courier view and the status bar."
        },
        "courier.audit.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Mark the findings of Studio's audit — an N+1 pattern, a timeout risk, a write without credentials — at the calls they concern, in the Problems panel too."
        },
        "courier.notifications.failures": {
          "type": "boolean",
          "default": false,
          "description": "Tell with a notification when a call to an endpoint fails while you work: at most once a minute per endpoint, several failing together in one notice."
        },
        "courier.agents.mcpServers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer VS Code's agent the MCP servers of each Courier project that has their package installed: its API as tools (`@noverax/courier-mcp`), and its running Studio (`@noverax/courier-studio mcp`)."
        }
      }
    },
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/define.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/define.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/call.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/call.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/call.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/call.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "courier.start",
        "title": "Get Started with Courier",
        "description": "From a project without Courier to every endpoint's calls in your editor, Studio beside your code, @courier in the chat, and your API in your agent's hands.",
        "steps": [
          {
            "id": "setUp",
            "title": "Set Courier up",
            "description": "Create Courier adds a typed example API, a mock, and a page that calls it, with the route your framework serves it through. It shows the plan first, and changes nothing until you agree.\n[Set Up Courier](command:courier.setUp)",
            "media": {
              "markdown": "media/walkthrough/set-up.md"
            },
            "completionEvents": [
              "onContext:courier.hasProject"
            ]
          },
          {
            "id": "startStudio",
            "title": "Start Courier Studio",
            "description": "Studio records every call your app makes, and runs the mocks. It starts in a terminal of its own, through your project's package manager.\n[Start Studio](command:courier.startStudio)",
            "media": {
              "image": {
                "light": "media/walkthrough/view-light.png",
                "dark": "media/walkthrough/view-dark.png",
                "hc": "media/walkthrough/view-dark.png",
                "hcLight": "media/walkthrough/view-light.png"
              },
              "altText": "The Courier view: the shop's endpoints grouped as the client names them, each with its calls, failures and p95."
            },
            "completionEvents": [
              "onContext:courier.studioRunning"
            ]
          },
          {
            "id": "hints",
            "title": "See how each call went",
            "description": "Above each call to an endpoint: how many calls it had, how many failed and how long nineteen in twenty took. Hover it for the statuses and the latest failure, and open that request in Studio's inspector.",
            "media": {
              "image": {
                "light": "media/walkthrough/hover-light.png",
                "dark": "media/walkthrough/hover-dark.png",
                "hc": "media/walkthrough/hover-dark.png",
                "hcLight": "media/walkthrough/hover-light.png"
              },
              "altText": "A hover over a call: the endpoint's calls, p50 and p95, statuses and its latest failure, with links into Studio."
            },
            "completionEvents": [
              "onView:courier.endpoints"
            ]
          },
          {
            "id": "studioTab",
            "title": "Open Studio beside your code",
            "description": "Studio's pages open in a tab of the editor's own, in its theme, and Called from opens each call site beside it. Go to Definition on a call opens its endpoint's declaration; Find All References lists every call.\n[Open Studio in Editor](command:courier.openStudioInEditor)",
            "media": {
              "image": {
                "light": "media/walkthrough/studio-tab-light.png",
                "dark": "media/walkthrough/studio-tab-dark.png",
                "hc": "media/walkthrough/studio-tab-dark.png",
                "hcLight": "media/walkthrough/studio-tab-light.png"
              },
              "altText": "Courier Studio in a tab beside the shop's checkout code, open at the orders.place endpoint, in the editor's theme."
            },
            "completionEvents": [
              "onCommand:courier.openStudioInEditor",
              "onCommand:courier.openStudioPage"
            ]
          },
          {
            "id": "live",
            "title": "Watch requests, switch mocks",
            "description": "The Requests view lists what your app sent, newest first; the Mocks view each mock Studio runs, its scenarios a click away, and its delays and faults.\n[Show the Requests](command:courier.requests.focus)",
            "media": {
              "image": {
                "light": "media/walkthrough/live-light.png",
                "dark": "media/walkthrough/live-dark.png",
                "hc": "media/walkthrough/live-dark.png",
                "hcLight": "media/walkthrough/live-light.png"
              },
              "altText": "The Requests view with the shop's latest requests, one failed, and the Mocks view with the shop's scenarios, the default one in force."
            },
            "completionEvents": [
              "onView:courier.requests",
              "onView:courier.mocks"
            ]
          },
          {
            "id": "chat",
            "title": "Ask @courier",
            "description": "In the chat, @courier answers from Studio: /status, /failures, /audit and /endpoint, and any question about your API's calls by the model you picked.\n[Ask @courier](command:workbench.action.chat.open?%7B%22query%22%3A%22%40courier%20/status%22%7D)",
            "media": {
              "image": {
                "light": "media/walkthrough/chat-light.png",
                "dark": "media/walkthrough/chat-dark.png",
                "hc": "media/walkthrough/chat-dark.png",
                "hcLight": "media/walkthrough/chat-light.png"
              },
              "altText": "@courier's answer about orders.place in the chat: its figures, its latest failure and calls, and an Open in Studio button."
            },
            "completionEvents": [
              "onCommand:workbench.action.chat.open"
            ]
          },
          {
            "id": "icons",
            "title": "Mark Courier's files",
            "description": "In Material Icon Theme or vscode-icons, courier.config.ts, courier.mocks.ts and the .courier folder can show Courier's own icons, the folder drawn in each theme's own style — by Courier File Icons, which comes with Courier and runs beside your icon theme, in a remote window too. Agree once: they follow you into the other theme, to your other machines through Settings Sync, through updates, and come out again everywhere just as easily.\n[Show Courier's Icons](command:courier.fileIcons.show)",
            "when": "courier.fileIconsReady",
            "media": {
              "image": {
                "light": "media/walkthrough/icons-light.png",
                "dark": "media/walkthrough/icons-dark.png",
                "hc": "media/walkthrough/icons-dark.png",
                "hcLight": "media/walkthrough/icons-light.png"
              },
              "altText": "The Explorer in vscode-icons with Courier's icons on .courier, courier.config.ts and courier.mocks.ts."
            },
            "completionEvents": [
              "onCommand:courier.fileIcons.show"
            ]
          },
          {
            "id": "agents",
            "title": "Give your agent the API",
            "description": "Each project that has @noverax/courier-mcp installed is offered to VS Code's agent: the endpoints its agents policy allows, as tools. With Studio installed, the agent reads the requests Studio recorded too.\n[Read about agents in your editor](https://courier.noverax.cloud/docs/agents/editor)",
            "media": {
              "markdown": "media/walkthrough/agent-servers.md"
            },
            "completionEvents": [
              "onLink:https://courier.noverax.cloud/docs/agents/editor"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "courier",
        "label": "Courier"
      }
    ],
    "chatParticipants": [
      {
        "id": "noverax.courier",
        "name": "courier",
        "fullName": "Courier",
        "description": "Ask about your API's calls: what fails, what is slow, what the audit found",
        "when": "courier.hasProject || courier.studioRunning",
        "sampleRequest": "Which endpoints fail, and why?",
        "commands": [
          {
            "name": "status",
            "description": "How every endpoint is doing: its calls, failures and latency"
          },
          {
            "name": "failures",
            "description": "The latest failed requests, and why they failed"
          },
          {
            "name": "audit",
            "description": "What the audit found in the requests, gravest first"
          },
          {
            "name": "endpoint",
            "description": "One endpoint, named or under the cursor: its figures, latest calls, declaration and callers"
          }
        ],
        "disambiguation": [
          {
            "category": "courier_api_calls",
            "description": "The user asks about the calls their app made to its API in this session, as Courier Studio recorded them: endpoints that fail or are slow, recent errors and status codes, or what Courier's audit found in the requests.",
            "examples": [
              "Why does the orders.place call keep failing?",
              "Which of my API endpoints are the slowest?",
              "What did the audit find in my requests?"
            ]
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "courier",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "studio",
              "verify",
              "openapi",
              "diff",
              "agents"
            ],
            "enumDescriptions": [
              "Courier Studio, and the mocks it runs",
              "Check every recorded call against the API as declared now",
              "Write each source as an OpenAPI document, into openapi/",
              "Report what a change to the API breaks, against origin/main",
              "List what the project offers agents, and why"
            ],
            "description": "The Courier command the task runs"
          },
          "project": {
            "type": "string",
            "description": "The project's folder, relative to the workspace folder; the first Courier project when left out"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch",
    "test:editor": "node tests/editor/run-in-editor.mjs",
    "prepackage": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "package": "vsce package --no-dependencies --out dist/courier.vsix"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  }
