{
  "name": "@noverax/courier-hono",
  "version": "0.0.0",
  "description": "Hono adapter for @noverax/courier — Web Standard proxy handler",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "hono",
    "edge",
    "adapter"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/hono"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*"
  },
  "peerDependencies": {
    "hono": ">=4",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  }
}
