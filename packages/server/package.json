{
  "name": "@noverax/courier-server",
  "version": "0.0.0",
  "description": "Standalone HTTP + WebSocket server for @noverax/courier — proxy handler for Next.js and serverless environments",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "server",
    "nodejs",
    "standalone",
    "http-server"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/server"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "courier-server": "lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier-studio-core": "*",
    "citty": "^0.2.2"
  },
  "peerDependencies": {
    "@noverax/courier": "*",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
