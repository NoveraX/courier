{
  "name": "@noverax/courier-mock",
  "version": "0.0.0",
  "description": "Type-safe mock server with stateful store, scenarios, chaos engineering, and visual builder for @noverax/courier",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "mock",
    "mocking",
    "testing",
    "fixtures"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/mock"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "import": "./lib/testing.js",
      "default": "./lib/testing.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./contract": {
      "types": "./lib/contract/index.d.ts",
      "import": "./lib/contract/index.js",
      "default": "./lib/contract/index.js"
    },
    "./managed": {
      "types": "./lib/managed/index.d.ts",
      "import": "./lib/managed/index.js",
      "default": "./lib/managed/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.19.0 || ^2.0.0",
    "@noverax/courier": "*",
    "hono": ">=4",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
