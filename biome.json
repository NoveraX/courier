{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/*/src/**",
      "packages/*/tsdown.config.ts",
      "packages/*/tests/**",
      "packages/studio/ui/src/**",
      "packages/studio/ui/__tests__/**",
      "scripts/**",
      "examples/*/src/**",
      "examples/*/courier.config.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noParameterAssign": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/*/tests/**",
        "packages/studio/ui/__tests__/**",
        "scripts/**/*.test.mjs"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "correctness": {
            "useYield": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/studio/ui/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": {
              "level": "error",
              "options": {
                "inputComponents": ["Checkbox", "Switch"]
              }
            }
          }
        }
      }
    }
  ]
}
