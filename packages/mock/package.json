{
  "name": "@noverax/nexus-mock",
  "version": "0.0.0",
  "description": "Type-safe mock server with stateful store, scenarios, chaos engineering, and visual builder for @noverax/nexus",
  "author": "NoveraX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js"
    },
    "./browser": {
      "types": "./lib/browser.d.ts",
      "import": "./lib/browser.js"
    },
    "./contract": {
      "types": "./lib/contract/index.d.ts",
      "import": "./lib/contract/index.js"
    },
    "./middleware": {
      "types": "./lib/middleware/index.d.ts",
      "import": "./lib/middleware/index.js"
    },
    "./managed/worker-entry": {
      "types": "./lib/managed/worker-entry.d.ts",
      "import": "./lib/managed/worker-entry.js"
    },
    "./route-analyzer": {
      "types": "./lib/auto/route-analyzer.d.ts",
      "import": "./lib/auto/route-analyzer.js"
    },
    "./schema-introspect": {
      "types": "./lib/auto/schema-introspect.d.ts",
      "import": "./lib/auto/schema-introspect.js"
    },
    "./data-generator": {
      "types": "./lib/auto/data-generator.d.ts",
      "import": "./lib/auto/data-generator.js"
    },
    "./meta-worker": {
      "types": "./lib/auto/meta-worker.d.ts",
      "import": "./lib/auto/meta-worker.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/nexus": "*"
  },
  "peerDependencies": {
    "hono": ">=4",
    "@hono/node-server": ">=1"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@hono/node-server": {
      "optional": true
    }
  }
}
