{
  "name": "@noverax/courier-solid",
  "version": "0.0.0",
  "description": "Solid Start adapter for @noverax/courier — Web Standard proxy handler",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/solid"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier": "*"
  },
  "peerDependencies": {
    "@solidjs/start": ">=1"
  }
}
