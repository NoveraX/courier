{
  "name": "@noverax/courier-server",
  "version": "0.3.1",
  "description": "Standalone server for Courier: your typed API's proxy over HTTP, SSE and WebSocket on its own port — for static and serverless front ends, Docker and Kubernetes",
  "keywords": [
    "courier",
    "server",
    "standalone",
    "proxy",
    "bff",
    "http-server",
    "sse",
    "websocket",
    "docker",
    "kubernetes",
    "typescript",
    "type-safe"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/server"
  },
  "homepage": "https://courier.noverax.cloud/docs/deployment/standalone-server",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "courier-server": "lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/courier-studio-core": "0.3.1",
    "citty": "^0.2.2"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.3.1",
    "ws": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
