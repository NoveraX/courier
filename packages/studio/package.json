{
  "name": "@noverax/nexus-studio",
  "version": "0.0.0",
  "description": "Standalone Studio server and UI for @noverax/nexus",
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noverax/nexus.git",
    "directory": "packages/studio"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "nexus-studio": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "import": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./vite": {
      "types": "./lib/vite.d.ts",
      "import": "./lib/vite.js",
      "default": "./lib/vite.js"
    },
    "./next": {
      "types": "./lib/next.d.ts",
      "import": "./lib/next.js",
      "default": "./lib/next.js"
    },
    "./nuxt": {
      "types": "./lib/nuxt.d.ts",
      "import": "./lib/nuxt.js",
      "default": "./lib/nuxt.js"
    },
    "./webpack": {
      "types": "./lib/webpack.d.ts",
      "import": "./lib/webpack.js",
      "default": "./lib/webpack.js"
    },
    "./esbuild": {
      "types": "./lib/esbuild.d.ts",
      "import": "./lib/esbuild.js",
      "default": "./lib/esbuild.js"
    },
    "./rollup": {
      "types": "./lib/rollup.d.ts",
      "import": "./lib/rollup.js",
      "default": "./lib/rollup.js"
    },
    "./astro": {
      "types": "./lib/astro.d.ts",
      "import": "./lib/astro.js",
      "default": "./lib/astro.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js",
      "default": "./lib/react.js"
    },
    "./vue": {
      "types": "./lib/vue.d.ts",
      "import": "./lib/vue.js",
      "default": "./lib/vue.js"
    },
    "./sveltekit": {
      "types": "./lib/sveltekit.d.ts",
      "import": "./lib/sveltekit.js",
      "default": "./lib/sveltekit.js"
    },
    "./remix": {
      "types": "./lib/remix.d.ts",
      "import": "./lib/remix.js",
      "default": "./lib/remix.js"
    },
    "./solid": {
      "types": "./lib/solid.d.ts",
      "import": "./lib/solid.js",
      "default": "./lib/solid.js"
    },
    "./angular": {
      "types": "./lib/angular.d.ts",
      "import": "./lib/angular.js",
      "default": "./lib/angular.js"
    },
    "./cli": "./lib/cli.js"
  },
  "files": [
    "lib",
    "ui/dist",
    "registry.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run build:ui",
    "test": "vitest run && npm run --prefix ui test",
    "build:server": "tsup",
    "build:ui": "cd ui && npx vite build",
    "dev": "tsup --watch",
    "dev:ui": "cd ui && npx vite",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/nexus": "*",
    "citty": "^0.1.6",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "open": "^10.2.0",
    "socket.io": "^4.8.3",
    "unplugin": "^3.0.0",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "astro": ">=4.0.0",
    "esbuild": ">=0.17.0",
    "next": ">=14.0.0",
    "nuxt": ">=3.0.0",
    "rollup": ">=3.0.0",
    "vite": ">=5.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/compression": "^1.8.1"
  }
}
