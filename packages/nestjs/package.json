{
  "name": "@noverax/nexus-nestjs",
  "version": "0.0.0",
  "description": "NestJS adapter for @noverax/nexus — module + middleware handler",
  "author": "NoveraX",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noverax/nexus": "*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
