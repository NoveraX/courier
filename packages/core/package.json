{
  "name": "@noverax/courier",
  "version": "0.1.0",
  "description": "Type-safe HTTP for any backend: define your API once in plain TypeScript and call it from server code and the browser — validated, with middleware, SSE, WebSockets and a secure proxy, no codegen",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "end-to-end-types",
    "api-client",
    "http-client",
    "rest",
    "fetch",
    "rpc",
    "bff",
    "proxy",
    "middleware",
    "validation",
    "standard-schema",
    "zod",
    "sse",
    "websocket",
    "realtime",
    "server-components",
    "edge"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/core"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./config": {
      "types": "./lib/config/index.d.ts",
      "import": "./lib/config/index.js",
      "default": "./lib/config/index.js"
    },
    "./define": {
      "types": "./lib/define/index.d.ts",
      "import": "./lib/define/index.js",
      "default": "./lib/define/index.js"
    },
    "./middleware": {
      "types": "./lib/middleware/index.d.ts",
      "import": "./lib/middleware/index.js",
      "default": "./lib/middleware/index.js"
    },
    "./node": {
      "types": "./lib/node.d.ts",
      "import": "./lib/node.js",
      "default": "./lib/node.js"
    },
    "./fetch": {
      "types": "./lib/fetch/index.d.ts",
      "import": "./lib/fetch/index.js",
      "default": "./lib/fetch/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "import": "./lib/testing/index.js",
      "default": "./lib/testing/index.js"
    },
    "./openapi": {
      "types": "./lib/openapi/index.d.ts",
      "import": "./lib/openapi/index.js",
      "default": "./lib/openapi/index.js"
    },
    "./webhooks": {
      "types": "./lib/webhooks/index.d.ts",
      "import": "./lib/webhooks/index.js",
      "default": "./lib/webhooks/index.js"
    },
    "./realtime": {
      "types": "./lib/realtime/index.d.ts",
      "import": "./lib/realtime/index.js",
      "default": "./lib/realtime/index.js"
    },
    "./internal-streams": {
      "types": "./lib/internal-streams/index.d.ts",
      "import": "./lib/internal-streams/index.js",
      "default": "./lib/internal-streams/index.js"
    },
    "./internal": {
      "types": "./lib/internal/index.d.ts",
      "import": "./lib/internal/index.js",
      "default": "./lib/internal/index.js"
    },
    "./announce": {
      "types": "./lib/announce/index.d.ts",
      "import": "./lib/announce/index.js",
      "default": "./lib/announce/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@types/request-ip": "^0.0.41",
    "request-ip": "^3.3.0"
  }
}
