{
  "name": "@noverax/courier-redis",
  "version": "0.2.0",
  "description": "Redis for Courier realtime: Pub/Sub that carries WebSocket channels across replicas, presence shared between them, and Streams that keep the events a reconnecting client resumes from",
  "keywords": [
    "courier",
    "redis",
    "pubsub",
    "redis-streams",
    "presence",
    "websocket",
    "sse",
    "realtime",
    "scaling",
    "replicas",
    "typescript",
    "type-safe"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/redis"
  },
  "homepage": "https://courier.noverax.cloud/docs/deployment/redis",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.2.0",
    "ioredis": "^5.3.0 || ^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
