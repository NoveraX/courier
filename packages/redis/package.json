{
  "name": "@noverax/courier-redis",
  "version": "0.0.0",
  "description": "Redis adapters for @noverax/courier realtime — Pub/Sub broadcast + Streams persistence",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "redis",
    "pubsub",
    "scaling",
    "websocket"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NoveraX/courier.git",
    "directory": "packages/redis"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@noverax/courier": "*"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
