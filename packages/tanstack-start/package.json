{
  "name": "@noverax/courier-tanstack-start",
  "version": "0.4.0",
  "description": "TanStack Start adapter for Courier: server routes that proxy typed calls to any backend, with the user's session in server functions, loaders and routes",
  "keywords": [
    "courier",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "react",
    "solid",
    "ssr",
    "server-functions",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/tanstack-start"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/tanstack-start",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js",
      "default": "./lib/react.js"
    },
    "./solid": {
      "types": "./lib/solid.d.ts",
      "import": "./lib/solid.js",
      "default": "./lib/solid.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "import": "./lib/plugin.js",
      "default": "./lib/plugin.js"
    },
    "./rsbuild": {
      "types": "./lib/rsbuild.d.ts",
      "import": "./lib/rsbuild.js",
      "default": "./lib/rsbuild.js"
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./lib/react.d.ts"
      ],
      "solid": [
        "./lib/solid.d.ts"
      ],
      "plugin": [
        "./lib/plugin.d.ts"
      ],
      "rsbuild": [
        "./lib/rsbuild.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.4.0",
    "@noverax/courier-build": "^0.4.0",
    "@rsbuild/core": "^2.0.0",
    "@tanstack/react-start": ">=1.169.0",
    "@tanstack/solid-start": ">=1.169.0",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@noverax/courier-build": {
      "optional": true
    },
    "@rsbuild/core": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "@tanstack/solid-start": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*",
    "@noverax/courier-build": "*"
  }
}
