{
  "name": "@noverax/courier-hono",
  "version": "0.1.0",
  "description": "Hono adapter for Courier on Web Standards: proxy typed calls to any backend from Node.js, Bun, Deno or Cloudflare Workers, with the user's session, SSE and WebSockets",
  "keywords": [
    "courier",
    "hono",
    "web-standards",
    "edge",
    "cloudflare-workers",
    "bun",
    "deno",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session",
    "sse",
    "websocket"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/hono"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/hono",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./request-context": {
      "types": "./lib/request-context.d.ts",
      "import": "./lib/request-context.js",
      "default": "./lib/request-context.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.1.0",
    "hono": ">=4",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
