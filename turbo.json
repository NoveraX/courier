{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "dist/**"]
    },
    "@noverax/courier-studio#build": {
      "dependsOn": ["^build", "@noverax/courier-studio-ui#build"],
      "outputs": ["lib/**", "ui/dist/**"]
    },
    "@noverax/courier-docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/src/content/docs/**",
        "$TURBO_ROOT$/docs/src/site/content/**",
        "$TURBO_ROOT$/docs/src/site/site-url.ts"
      ],
      "outputs": ["docs/**", "lib/**"]
    },
    "@noverax/courier-studio-ui#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/routeTree.gen.ts"]
    },
    "@noverax/courier-studio-ui#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "@noverax/courier#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    }
  }
}
