  {
    "id": "react-router",
    "start": ["npx", "react-router", "dev", "--port", "{port}", "--strictPort"],
    "page": "/courier"
  },
  {
    "id": "solid-start",
    "start": ["npx", "vite", "dev", "--port", "{port}", "--strictPort"],
    "page": "/courier"
  },
  {
    "id": "react",
    "start": ["npx", "vite", "--port", "{port}", "--strictPort"],
    "page": "/courier.html"
  },
  {
    "id": "vue",
    "start": ["npx", "vite", "--port", "{port}", "--strictPort"],
    "page": "/courier.html"
  },
