{
  "name": "@noverax/courier-remix",
  "version": "0.2.0",
  "description": "React Router and Remix adapter for Courier: a resource route that proxies typed calls to any backend, with the user's session in loaders and actions",
  "keywords": [
    "courier",
    "react-router",
    "remix",
    "loaders",
    "actions",
    "ssr",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/remix"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/remix",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./request-context": {
      "types": "./lib/request-context.d.ts",
      "import": "./lib/request-context.js",
      "default": "./lib/request-context.js"
    }
  },
  "typesVersions": {
    "*": {
      "request-context": [
        "./lib/request-context.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.2.0"
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
