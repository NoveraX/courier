{
  "name": "@noverax/courier-react",
  "version": "0.2.0",
  "description": "React hooks for Courier on TanStack Query: useQuery, useMutation, useSuspenseQuery and useInfiniteQuery typed from your API definition, with live SSE and WebSocket hooks and optimistic updates",
  "keywords": [
    "courier",
    "react",
    "react-query",
    "tanstack-query",
    "hooks",
    "suspense",
    "data-fetching",
    "typescript",
    "type-safe",
    "api-client",
    "sse",
    "websocket",
    "optimistic-updates"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/react"
  },
  "homepage": "https://courier.noverax.cloud/docs/react-query/setup",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.2.0",
    "@tanstack/react-query": "^5.80.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
