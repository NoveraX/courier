{
  "name": "@noverax/courier-nuxt",
  "version": "0.0.0",
  "description": "Nuxt adapter for @noverax/courier — h3/Nitro event handler",
  "keywords": [
    "courier",
    "typescript",
    "type-safe",
    "api-client",
    "nuxt",
    "nitro",
    "h3",
    "vue",
    "adapter"
  ],
  "author": "NoveraX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://courier.noverax.cloud",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "*"
  },
  "devDependencies": {
    "@noverax/courier": "*"
  }
}
