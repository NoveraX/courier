{
  "name": "@noverax/courier-monorepo",
  "private": true,
  "description": "Type-safe HTTP client with dual-mode transport, middleware chain, and runtime validation",
  "author": "NoveraX",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "packages/studio/ui",
    "examples/basic",
    "examples/demo-shop"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git"
  },
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "homepage": "https://courier.noverax.cloud",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "file:./scripts/stubs/semantic-release-npm",
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "ajv": "^8.20.0",
    "arktype": "^2.2.3",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fastify": "^5.12.5",
    "h3": "^2.0.1-rc.32",
    "hono": "^4.13.8",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "next": "^16.4.0",
    "ovsx": "^1.2.0",
    "oxc-transform-react": "0.155.0",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "socket.io-client": "^4.8.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "undici": "^8.11.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@semantic-release/npm": "$@semantic-release/npm",
    "@azure/identity": {
      "@azure/msal-node": "^7.1.0"
    },
    "@vitejs/plugin-react": {
      "oxc-transform-react": "$oxc-transform-react"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 20",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:scale": "node scripts/scale/run.mjs",
    "test:frameworks": "node scripts/test-frameworks.mjs",
    "test:quickstart": "node scripts/test-quickstart.mjs",
    "test:watch": "vitest",
    "lint": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:names": "node scripts/check-name-conflicts.mjs",
    "check:npx": "node scripts/check-npx-commands.mjs",
    "check:biome": "node scripts/check-biome-config.mjs",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:any": "node scripts/check-implicit-any.mjs",
    "check:docs": "node scripts/check-doc-samples.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:publish": "node scripts/check-publish.mjs",
    "check:browser": "node scripts/check-browser-bundles.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:page-dates": "node scripts/check-page-dates.mjs",
    "check:skipped": "node scripts/check-skipped-tests.mjs",
    "check:names:test": "vitest run scripts/check-name-conflicts.test.mjs",
    "release": "HUSKY=0 semantic-release",
    "prepare": "husky"
  },
  "lint-staged": {
    "{packages,scripts,examples,e2e}/**/*.{ts,tsx,mjs,css}": "biome check --write --no-errors-on-unmatched"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
