{
  "name": "@noverax/courier-nuxt",
  "version": "0.3.1",
  "description": "Nuxt adapter for Courier: a Nitro event handler that proxies typed calls to any backend, with the user's session in server routes and the pages Nuxt renders",
  "keywords": [
    "courier",
    "nuxt",
    "nitro",
    "h3",
    "vue",
    "ssr",
    "proxy",
    "bff",
    "typescript",
    "type-safe",
    "api-client",
    "session"
  ],
  "author": {
    "name": "NoveraX",
    "url": "https://github.com/NoveraX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoveraX/courier.git",
    "directory": "packages/nuxt"
  },
  "homepage": "https://courier.noverax.cloud/docs/frameworks/nuxt",
  "bugs": {
    "url": "https://github.com/NoveraX/courier/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "import": "./lib/plugin.js",
      "default": "./lib/plugin.js"
    }
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "./lib/plugin.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsdown --watch"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@noverax/courier": "^0.3.1",
    "@noverax/courier-build": "^0.3.1",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@noverax/courier-build": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@noverax/courier": "*",
    "@noverax/courier-build": "*"
  }
}
